NODE_ENV=development
PORT=3001
DB_HOST=YOUR_DB_HOST.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
# Poolers gestionados (Supabase, Neon, Railway...) usan una CA privada.
# Opciones, en orden de preferencia:
#   1) DB_SSL_CA=certs/supabase-ca.pem  -> verifica el certificado (recomendado en produccion)
#   2) DB_SSL_REJECT_UNAUTHORIZED=false -> cifrado sin validar el certificado (solo dev)
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=certs/supabase-ca.pem
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://YOUR_IP:3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash